  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "schemas": {
      "CreateDealer": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "code": {
            "type": "string",
            "minLength": 1,
            "maxLength": 50,
            "pattern": "^[A-Za-z0-9_-]+$"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "phone": {
            "type": "string",
            "minLength": 1,
            "maxLength": 20,
            "pattern": "^\\+?[0-9]{8,15}$"
          },
          "address": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "email": {
            "type": "string",
            "format": "email",
            "maxLength": 254
          },
          "districtId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "tierId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "receivedDate": {
            "type": "string",
            "format": "date-time"
          },
          "status": {
            "type": "string",
            "enum": [
              "ACTIVE",
              "INACTIVE",
              "SUSPENDED"
            ]
          }
        },
        "required": [
          "code",
          "name",
          "phone",
          "address",
          "email",
          "districtId",
          "tierId",
          "receivedDate"
        ]
      },
      "UpdateDealer": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "code": {
            "type": "string",
            "minLength": 1,
            "maxLength": 50,
            "pattern": "^[A-Za-z0-9_-]+$"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "phone": {
            "type": "string",
            "minLength": 1,
            "maxLength": 20,
            "pattern": "^\\+?[0-9]{8,15}$"
          },
          "address": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "email": {
            "type": "string",
            "format": "email",
            "maxLength": 254
          },
          "districtId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "tierId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "receivedDate": {
            "type": "string",
            "format": "date-time"
          },
          "status": {
            "type": "string",
            "enum": [
              "ACTIVE",
              "INACTIVE",
              "SUSPENDED"
            ]
          }
        },
        "minProperties": 1
      },
      "Dealer": {
        "type": "object",
        "required": [
          "code",
          "name",
          "phone",
          "address",
          "email",
          "districtId",
          "tierId",
          "receivedDate",
          "status",
          "id",
          "currentDebt",
          "createdAt",
          "updatedAt",
          "district",
          "tier"
        ],
        "properties": {
          "code": {
            "type": "string",
            "minLength": 1,
            "maxLength": 50,
            "pattern": "^[A-Za-z0-9_-]+$"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "phone": {
            "type": "string",
            "minLength": 1,
            "maxLength": 20,
            "pattern": "^\\+?[0-9]{8,15}$"
          },
          "address": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "email": {
            "type": "string",
            "format": "email",
            "maxLength": 254
          },
          "districtId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "tierId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "receivedDate": {
            "type": "string",
            "format": "date-time"
          },
          "status": {
            "type": "string",
            "enum": [
              "ACTIVE",
              "INACTIVE",
              "SUSPENDED"
            ]
          },
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "currentDebt": {
            "type": "integer",
            "description": "VND balance owned by P5; read only",
            "readOnly": true
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          },
          "district": {
            "$ref": "#/components/schemas/District"
          },
          "tier": {
            "$ref": "#/components/schemas/DealerTier"
          }
        }
      },
      "District": {
        "type": "object",
        "required": [
          "id",
          "code",
          "name",
          "isActive",
          "maxDealers",
          "createdAt",
          "updatedAt"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "code": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "isActive": {
            "type": "boolean"
          },
          "maxDealers": {
            "type": "integer",
            "description": "Legacy field; actual capacity is BusinessRule.QD1.maxDealersPerDistrict"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "DealerTier": {
        "type": "object",
        "required": [
          "id",
          "name",
          "isActive",
          "maxDebt",
          "createdAt",
          "updatedAt"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "name": {
            "type": "string"
          },
          "isActive": {
            "type": "boolean"
          },
          "maxDebt": {
            "type": "integer",
            "description": "VND; P5 credit logic may override using QD3 configuration"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "Pagination": {
        "type": "object",
        "required": [
          "total",
          "page",
          "limit",
          "totalPages"
        ],
        "properties": {
          "total": {
            "type": "integer"
          },
          "page": {
            "type": "integer"
          },
          "limit": {
            "type": "integer"
          },
          "totalPages": {
            "type": "integer"
          }
        }
      },
      "Error": {
        "type": "object",
        "required": [
          "success",
          "code",
          "message"
        ],
        "properties": {
          "success": {
            "type": "boolean",
            "enum": [
              false
